# ── إعدادات Supabase (انسخ هذا الملف إلى .env واملأ القيم) ──
# من لوحة تحكم Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# النطاق الداخلي المستخدم لتحويل المعرّف إلى بريد للمصادقة (لا يُرسَل إليه بريد فعلي)
VITE_AUTH_EMAIL_DOMAIN=sarouji.local
